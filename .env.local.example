# Nautilus dashboard — environment template.
# Copy to .env.local and fill in. Never commit .env.local.

# ─── Transactional email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
# From-address for system/invite email (e.g. "Nautilus <ops@your-domain.com>").
SYSTEM_EMAIL_FROM=

# ─── App origin ───────────────────────────────────────────────────────────────
# Used for OAuth redirect targets and transactional email links.
# Dev: http://localhost:3000   Prod: https://app.<apex>
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public site origin used for OAuth redirects (usually same as APP_URL in dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# These NEXT_PUBLIC_ values are safe to expose to the browser (RLS enforces auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The PostgREST schema the dashboard reads/writes against. Must match one of the
# schemas in Supabase → Settings → API → Exposed schemas. Always `app`.
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=app
# Service-role key — SERVER ONLY. Bypasses RLS. Never expose to the client.
# Without it, integration callbacks and all /admin routes throw.
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI narration ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Integrations ─────────────────────────────────────────────────────────────
# Key used to encrypt stored integration credentials at rest.
INTEGRATION_ENCRYPTION_KEY=
# Shopify OAuth (only needed if using the Shopify integration).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────
# Server-only secret key (test: sk_test_…, live: sk_live_…). Without it the
# billing UI shows "not configured" and self-serve plans are disabled.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) for /api/webhooks/stripe. Create the endpoint
# in Stripe → Developers → Webhooks pointing at <APP_URL>/api/webhooks/stripe and
# subscribe to checkout.session.completed + customer.subscription.* events.
STRIPE_WEBHOOK_SECRET=
# Stripe Price ids per tier + period. Set only the ones you offer; unset ones
# simply don't render a checkout button.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret guarding scheduled routes (e.g. /api/cron/stockout-alerts).
# The scheduler must send `Authorization: Bearer <CRON_SECRET>`. Without this
# set, the cron routes return 401 and never run. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
